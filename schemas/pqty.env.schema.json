{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/backmatter/pqty/main/schemas/pqty.env.schema.json",
  "title": "pqty resolved environment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fingerprint",
    "lock_schema",
    "registries",
    "requirements",
    "packages",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "pqty.env/v1"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lock_schema": {
      "type": "string"
    },
    "registries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registry"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "external_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "font_maps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\]+\\.map$"
      },
      "uniqueItems": true
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "url",
        "metadata_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "tlnet"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string"
        },
        "metadata_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "kind",
        "locator"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "kind": {
          "const": "registry"
        },
        "locator": {
          "type": "string"
        },
        "container_checksum": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{128}$"
        },
        "container_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependentRequired": {
        "container_checksum": [
          "container_size"
        ],
        "container_size": [
          "container_checksum"
        ]
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "version",
        "source",
        "integrity",
        "direct"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
        },
        "direct": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_name",
        "tds_path",
        "owner",
        "kind"
      ],
      "properties": {
        "request_name": {
          "type": "string",
          "minLength": 1
        },
        "tds_path": {
          "type": "string",
          "pattern": "^(?!texmf-dist/)(?!RELOC/)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//).+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/resource_kind"
        }
      }
    },
    "resource_kind": {
      "enum": [
        "tex",
        "bibliography",
        "font-metric",
        "virtual-font",
        "type1-font",
        "open-type-font",
        "true-type-font",
        "font-family",
        "map",
        "encoding",
        "hyphenation",
        "format",
        "binary",
        "data"
      ]
    }
  }
}
